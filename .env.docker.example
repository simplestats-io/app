# Copy to .env next to docker-compose.yml and fill in the required values.
# Every other setting of .env.example can be added here as well (backups,
# AI assistant, GeoIP, ...), it is passed to all containers.

# --- Required ---------------------------------------------------------------

# The exact URL your users open. Changing it later invalidates registered passkeys.
APP_URL=https://stats.example.com

# Generate once with: echo "base64:$(openssl rand -base64 32)"
# Never change it afterwards: encrypted data and sessions depend on it.
APP_KEY=

DB_PASSWORD=

# Mail is required: team invitations are the only way to add users.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=stats@example.com
MAIL_FROM_NAME=SimpleStats
APP_MAIL=stats@example.com
ADMIN_MAIL=admin@example.com

# --- Optional ---------------------------------------------------------------

# Pin a release (recommended), e.g. 6, 6.2 or 6.2.0. Defaults to latest.
# SIMPLESTATS_VERSION=6

# Only for `docker compose --profile https up -d`: Caddy requests a
# Let's Encrypt certificate for this domain (DNS must point to this server).
# DOMAIN=stats.example.com

# Where the app container listens when you use your own reverse proxy.
# APP_BIND=127.0.0.1
# APP_PORT=8080

# EXCHANGE_RATES_API_KEY=
# MAXMIND_LICENSE_KEY=
