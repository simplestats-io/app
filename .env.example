APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Reverse proxies to trust for HTTPS and client IP detection: "*" or a comma separated list of IPs
# TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simplestats
DB_USERNAME=forge
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local

# while testing "sync" is okay, but for production you should use database or something else.
QUEUE_CONNECTION=sync

# Horizon worker tuning. Defaults shown; tune to your traffic and server specs.
#HORIZON_INGEST_MIN_PROCESSES=3
#HORIZON_INGEST_MAX_PROCESSES=10
#HORIZON_DEFAULT_MIN_PROCESSES=2
#HORIZON_DEFAULT_MAX_PROCESSES=5
#HORIZON_LOW_MIN_PROCESSES=1
#HORIZON_LOW_MAX_PROCESSES=1

SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=SimpleStats
APP_MAIL=app@example.com
# Receives backup failures, queue alerts and user feedback
ADMIN_MAIL=admin@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The s3 disk (offsite backups, shared import storage) has its own credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DEFAULT_REGION=us-east-1
S3_BUCKET=
S3_URL=
S3_ENDPOINT=
S3_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_ENV="${APP_ENV}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Requests per minute and project on the API (self-hosted has no other plan limits)
SELF_HOSTED_API_RATE_LIMIT=10000

# API to calculate currency rates.
# Supported providers: https://github.com/ash-jc-allen/laravel-exchange-rates?tab=readme-ov-file#supported-apis
# We recommend https://currencybeacon.com, they have the best free plan.
EXCHANGE_RATES_API_KEY=

# GeoIP service. We use https://www.maxmind.com/en/home, it is free.
# Just create an account and put the key here.
MAXMIND_USER_ID=
MAXMIND_LICENSE_KEY=

# AI chat assistant (laravel/ai). see config/ai.php for more options.
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
AI_CHAT_DAILY_MESSAGE_LIMIT=100
