{
    "name": "simplestats-io/app",
    "type": "project",
    "description": "Open source, server-side analytics for Laravel applications (self-hosted).",
    "keywords": ["laravel", "analytics", "server-side", "gdpr", "self-hosted"],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-zip": "*",
        "ashallendesign/laravel-exchange-rates": "^7.2",
        "beyondcode/laravel-favicon": "^1.6",
        "fakerphp/faker": "^1.9.1",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^2.0",
        "joelbutcher/socialstream": "^6.2",
        "lab404/laravel-impersonate": "^1.7",
        "laracraft-tech/laravel-useful-additions": "^4.1",
        "laravel/ai": "^0.8.1",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.33",
        "laravel/jetstream": "^5.0",
        "laravel/mcp": "^1.1.1",
        "laravel/pulse": "^1.2",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/iso3166": "^4.3",
        "maatwebsite/excel": "^3.1",
        "matomo/device-detector": "^6.0",
        "mateusjunges/laravel-trackable-jobs": "^2.0",
        "sentry/sentry-laravel": "^4.7",
        "spatie/laravel-backup": "^9.0",
        "spatie/laravel-deleted-models": "^1.1",
        "spatie/laravel-health": "^1.34",
        "spatie/laravel-validation-rules": "^3.3",
        "stevebauman/location": "^7.2",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.9",
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "laravel/telescope": "^5.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ignition": "^2.0",
        "spatie/pest-plugin-route-testing": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "check": [
            "@test:lint",
            "@test:types",
            "@test:refactor",
            "@test:arch"
        ],
        "lint": "pint",
        "refactor": "rector",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "pest --parallel --compact"
        ],
        "test:arch": "pest --testsuite=Arch",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:types": "phpstan analyse --memory-limit=2G",
        "types:generate-baseline": "@test:types --generate-baseline"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.32"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
